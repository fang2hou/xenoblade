{
  "name": "xenoblade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @xenoblade/platform-worker dev",
    "dev:runtime": "pnpm --filter @xenoblade/discord-runtime dev",
    "typecheck": "pnpm --filter @xenoblade/platform-worker typecheck",
    "test": "pnpm --filter @xenoblade/bot-worker test",
    "lint": "oxlint .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}

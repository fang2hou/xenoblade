{
  "name": "xenoblade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @xenoblade/platform-worker dev",
    "dev:runtime": "pnpm --filter @xenoblade/discord-runtime dev",
    "typecheck": "pnpm --filter @xenoblade/platform-worker typecheck",
    "test": "pnpm vitest run packages/ai/test/",
    "lint": "oxlint .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}

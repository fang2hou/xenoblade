{
  "name": "@xenoblade/bot-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec wrangler dev --local",
    "build": "pnpm exec wrangler deploy --dry-run",
    "generate-types": "pnpm exec wrangler types",
    "typecheck": "pnpm exec tsc -p ../../tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm exec vitest run test/unit --config vitest.unit.config.ts",
    "test:worker": "pnpm exec vitest run --config vitest.config.ts",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply xenoblade-dev --local",
    "db:migrate": "pnpm exec wrangler d1 migrations apply xenoblade-dev --remote"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.36.0",
    "@xenoblade/ai": "workspace:*",
    "@xenoblade/db": "workspace:*",
    "ai": "7.0.55",
    "chat": "4.36.0",
    "chat-state-cloudflare-do": "0.2.0",
    "discord-gateway-cloudflare-do": "0.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "wrangler": "4.119.0"
  }
}

# Deployment configuration.
#
# Copy this file to .env.deploy and fill in the values.
# .env.deploy is gitignored and must never be committed.
#
# ---------------------------------------------------------------------------
# Self-hosted host (SSH access)
# ---------------------------------------------------------------------------
GATEWAY_HOST=your-host.example.com
GATEWAY_USER=deploy
GATEWAY_SSH_PORT=22
GATEWAY_DEPLOY_PATH=/opt/xenoblade

# ---------------------------------------------------------------------------
# Docker Registry (on the self-hosted host)
# ---------------------------------------------------------------------------
# The deploy script auto-logs-in if DOCKER_REGISTRY_USER and DOCKER_REGISTRY_PASS are set.
# Alternatively, run `docker login` manually once.
DOCKER_REGISTRY_URL=your-registry.example.com
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASS=
IMAGE_NAME=xenoblade/discord-runtime
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Health check
# ---------------------------------------------------------------------------
HEALTH_CHECK_URL=http://localhost:8397/health
HEALTH_CHECK_RETRIES=15
HEALTH_CHECK_INTERVAL=2

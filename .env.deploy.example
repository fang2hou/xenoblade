# Deployment configuration.
#
# Copy this file to .env.deploy and fill in the values.
# .env.deploy is gitignored and must never be committed.
#
# ---------------------------------------------------------------------------
# Self-hosted host (SSH access)
# ---------------------------------------------------------------------------
RUNTIME_HOST=your-host.example.com
RUNTIME_USER=deploy
RUNTIME_SSH_PORT=22
RUNTIME_DEPLOY_PATH=/opt/xenoblade

# ---------------------------------------------------------------------------
# Docker Registry (on the self-hosted host)
# ---------------------------------------------------------------------------
# Run `docker login` before deploying:
#   docker login your-registry.example.com -u <user> -p <pass>
REGISTRY_URL=your-registry.example.com
IMAGE_NAME=xenoblade/discord-runtime
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Health check
# ---------------------------------------------------------------------------
HEALTH_CHECK_URL=http://localhost:3000/health
HEALTH_CHECK_RETRIES=15
HEALTH_CHECK_INTERVAL=2

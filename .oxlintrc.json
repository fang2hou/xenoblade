{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {},
  "ignorePatterns": ["node_modules/**", ".wrangler/**"],
  "rules": {
    "no-unused-vars": "error",
    "@typescript-eslint/no-unused-vars": "error",
    "eqeqeq": ["error", "smart"],
    "require-await": "error",
    "no-console": "warn",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**/*.ts", "**/*.test.ts"],
      "rules": {
        "no-console": "off",
        "require-await": "off"
      }
    }
  ]
}

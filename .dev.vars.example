# Required Platform Worker secrets (copy to apps/platform-worker/.dev.vars)
# Configure HYPER_API_KEY (routes DeepSeek via Charm Hyper) and/or OPENROUTER_API_KEY
INTERNAL_API_TOKEN=
HYPER_API_KEY=
OPENROUTER_API_KEY=

# Optional tool & MCP secrets
BRAVE_SEARCH_API_KEY=
BRAVE_ANSWER_API_KEY=
GITHUB_MCP_TOKEN=
ARTIFICIAL_ANALYSIS_API_KEY=

# Optional owner-approved server administration gate (both required to enable)
ADMIN_GUILD_ID=
ADMIN_OWNER_USER_ID=

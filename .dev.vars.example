# Discord application secrets (from Discord Developer Portal)
DISCORD_BOT_TOKEN=
# Discord application public key (Ed25519 verification)
DISCORD_PUBLIC_KEY=
# Discord application ID (OAuth2 / General Information)
DISCORD_APPLICATION_ID=

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Gateway control token: authorizes POST /gateway/connect and /gateway/disconnect
GATEWAY_CONTROL_TOKEN=
# Gateway status token: authorizes GET /gateway/status (must differ from control token)
GATEWAY_STATUS_TOKEN=
